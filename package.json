{
  "name": "aesthetic-aura-clinic",
  "private": true,
  "version": "1.0.0",
  "description": "Clinic Management System",
  "author": "Aesthetic Aura Clinic",
  "main": "src/main.cjs",
  "type": "module",
  "scripts": {
    "start": "concurrently \"vite\" \"electron .\"",
    "dev": "concurrently \"vite\" \"electron .\"",
    "electron": "electron .",
    "build": "vite build",
    "dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "preview": "vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.aestheticaura.clinic",
    "productName": "Aesthetic Aura Clinic",
    "directories": {
      "output": "dist_electron"
    },
    "icon": "public/resources/logo.jpeg",
    "files": [
      "dist/**/*",
      "src/main.cjs",
      "src/preload.cjs",
      "src/db.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/resources/logo.jpeg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "better-sqlite3": "^12.6.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "^40.4.0",
    "electron-builder": "^26.7.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}